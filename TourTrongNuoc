package QuanLyTour;

public class TourTrongNuoc extends Tour {
    private String mien;
    private String tinh;
    private static int count = 1;

    public TourTrongNuoc() {
        super();
        mien = "";
        tinh = "";
    }

    public TourTrongNuoc(String matour, String tentour, String noikhoihanh, String ngaykhoihanh, String ngayve, int gia, String mien, String tinh) {
        super(matour, tentour, noikhoihanh, ngaykhoihanh, ngayve, gia);
        this.mien = mien;
        this.tinh = tinh;
        count++;
    }

    public String toString() {
        return super.toString() + ", Mien: " + mien + ", Tinh: " + tinh;
    }

    // getter
    public String getmien() {
        return mien;
    }
    public String gettinh() {
        return tinh;
    }

    // setter
    public void setmatour(String matourtn){
        super.setmatour(matourtn);
    }
    public void setmien(String mien) {
        while(mien.trim().equals("")){
            System.out.println("Mien khong duoc de trong, vui long nhap lai!");
            System.out.print("Nhap mien: ");
            mien = sc.nextLine();
        }
        this.mien = mien;
    }
    public void settinh(String tinh) {
        while(tinh.trim().equals("")){
            System.out.println("Tinh khong duoc de trong, vui long nhap lai!");
            System.out.print("Nhap tinh: ");
            tinh = sc.nextLine();
        }
        this.tinh = tinh;
    }

    public void nhap() {
        System.out.println("Nhap thong tin tour trong nuoc:");
        super.nhap();
        System.out.print("Nhap mien: "); setmien(Input.sc.nextLine());
        System.out.print("Nhap tinh: "); settinh(Input.sc.nextLine());
        setmatour("TTN" + count);
    }
    public void xuat() {
        System.out.println("Thong tin tour trong nuoc:");
        System.out.println(this.toString());
    }
}
