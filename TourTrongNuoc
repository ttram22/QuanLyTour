package QuanLyTour;

public class TourTrongNuoc extends Tour {
    private String mien;
    private String tinh;

    public TourTrongNuoc() {
        super();
        mien = "";
        tinh = "";
    }

    public TourTrongNuoc(String matour, String tentour, String noikhoihanh, String ngaykhoihanh, String ngayve, double gia, String mien, String tinh) {
        super(matour, tentour, noikhoihanh, ngaykhoihanh, ngayve, gia);
        this.mien = mien;
        this.tinh = tinh;
    }

    // getter
    public String getmien() {
        return mien;
    }
    public String gettinh() {
        return tinh;
    }

    public String toString() {
        return super.toString() + ", Mien: " + mien + ", Tinh: " + tinh;
    }

    // setter
    public void setmien(String mien) {
        this.mien = mien;
    }
    public void settinh(String tinh) {
        this.tinh = tinh;
    }

    public void nhap() {
        System.out.println("Nhap thong tin tour trong nuoc:");
        super.nhap();
        System.out.print("Nhap mien: "); setmien(Input.sc.nextLine());
        System.out.print("Nhap tinh: "); settinh(Input.sc.nextLine());
    }
    public void xuat() {
        System.out.println("Thong tin tour trong nuoc:");
        System.out.println(this.toString());
    }
}
