      public static void printCenterTitle(String title, int width) {
            // total of char need to add left and right 
            int totalPadding = width - title.length();
            int left = totalPadding / 2;
            int right = totalPadding - left;
            System.out.println("=".repeat(left) + " " + title + " " + "=".repeat(right));
      }

      public static void login(Scanner sc) {
            _AuthService auth = new _AuthService();
            int WIDTH = _MenuManageTour.WIDTH;

            String title = "DANG NHAP";

            // login loop 
            boolean logged = false;
            while(!logged) {
                  _MenuManageTour.printCenterTitle(title, WIDTH);
                  System.out.print("Username:"); String Username = sc.nextLine();
                  System.out.print("Password:"); String Password = sc.nextLine();
                  
                  String role = auth.login(Username, Password);

                  if (role == null) {
                        System.out.println("*".repeat(WIDTH/3) + "Ban da nhap sai tai khoan hoac mat khau!" + "*".repeat(WIDTH/3));
                        System.out.println("Vui long lua chon\nNhan phim 1 de dang nhap lai hoac nhan phim bat ky de thoat.");
                        String tmp = "";
                        tmp = sc.nextLine();
                        if(tmp.equals("1")) {
                              System.out.println("Da chon dang nhap lai tai khoan!");
                        }
                        else break;
                  }
                  else {
                        logged = true;
                        System.out.println("Dang nhap thanh cong!");
                        if (role.equals("manager")) {
                              managermenu(sc); 
                        } 
                        else {
                              staffmenu(sc); 
                        }
                  }
            }
      }

