      public static void showMenuFindTour(Scanner sc) {
            int choice;
            String title = "Tim kiem tour";
            int WIDTH = _MenuManageTour.WIDTH;

            do {
                  _MenuManageTour.printCenterTitle(title, WIDTH);
                  System.out.println("1. Tim kiem theo ma tour");
                  System.out.println("2. Tim kiem theo ten tour");
                  System.out.println("3. Tim kiem theo khoang gia");
                  System.out.println("4. Tim kiem theo loai tour (trong nuoc/quoc te)");
                  System.out.println("0. Thoat");
                  System.out.print("Lua chon: "); choice = sc.nextInt(); sc.nextLine();

                  switch (choice) {
                        case 0: 
                              break;
                        case 1:
                              System.out.print("Nhap ma tour can tim: "); String ma = sc.nextLine();
                              Tour timma = dstour.timkiem(ma); 
                              if (timma != null) 
                                    System.out.println(timma);
                              else 
                                    System.out.println("Khong tim thay tour co ma: " + ma);
                              break;
                        case 2:
                              System.out.print("Nhap ten tour can tim: "); String ten = sc.nextLine();
                              Tour timten = dstour.timkiemten(ten); 
                              if (timten != null) 
                                    System.out.println(timten);
                              else 
                                    System.out.println("Khong tim thay tour co ma: " + ten);
                              break;
                        case 3:
                              System.out.print("Nhap gia thap nhat: "); double min = sc.nextDouble(); sc.nextLine();
                              System.out.print("Nhap gia cao nhat: "); double max = sc.nextDouble(); sc.nextLine();
                              Tour timgia = dstour.timkiemgia(min, max); 
                              if (timgia != null) 
                                    System.out.println(timgia);
                              else 
                                    System.out.println("Khong tim thay tour co gia trong khoang tu " + min + " den " + max);
                              break;
                        case 4:
                              System.out.print("Nhap loai tour can tim: "); String loai = sc.nextLine();
                              Tour timloai = dstour.timkiemloaitour(loai); 
                              if (timloai != null) 
                                    System.out.println(timloai);
                              else 
                                    System.out.println("Khong tim thay tour " + loai + " nao.");
                              break;
                        default:
                              System.out.println();
                              System.out.println("*".repeat(WIDTH/3) +" Lua chon khong hop le. Vui long thu lai." + "*".repeat(WIDTH/3));
                  }
            }
            while(choice != 0);
      }
}
