      public static void showMenuFindTour(Scanner sc) {
            int choice;
            String title = "Tim kiem tour";
            int WIDTH = _MenuManageTour.WIDTH;

            do {
                  _MenuManageTour.printCenterTitle(title, WIDTH);
                  System.out.println("1. Tim kiem theo ma tour");
                  System.out.println("2. Tim kiem theo ten tour");
                  System.out.println("3. Tim kiem theo khoang gia");
                  System.out.println("4. Tim kiem theo loai tour (tour trong nuoc/tour quoc te)");
                  System.out.println("0. Thoat");
                  System.out.print("Lua chon: "); choice = sc.nextInt(); sc.nextLine();

                  switch (choice) {
                        case 0: 
                              break;
                        case 1:
                              System.out.print("Nhap ma tour can tim: "); 
                              String ma = sc.nextLine(); ma = ma.trim().replaceAll("\\s+", " ");
                              Tour timma = dstour.timkiem(ma); 
                              if (timma != null) 
                                    System.out.println(timma);
                              else 
                                    System.out.println("Khong tim thay tour co ma: " + ma);
                              break;
                        case 2:
                              System.out.print("Nhap ten tour can tim: "); String ten = sc.nextLine(); ten = ten.trim().replaceAll("\\s+", " ");
                              Tour timten = dstour.timkiemten(ten); 
                              if (timten != null) 
                                    System.out.println(timten);
                              else 
                                    System.out.println("Khong tim thay tour co ten: " + ten);
                              break;
                        case 3:
                              System.out.print("Nhap gia thap nhat: "); int min = sc.nextInt(); sc.nextLine();
                              System.out.print("Nhap gia cao nhat: "); int max = sc.nextInt(); sc.nextLine();
                              ArrayList<Tour> timgia = dstour.timkiemgia(min, max); 
                              if (!timgia.isEmpty()) 
                                    timgia.forEach(System.out::println);
                              else 
                                    System.out.println("Khong tim thay tour co gia trong khoang tu " + min + " den " + max);
                              break;
                        case 4:
                              System.out.print("Nhap loai tour can tim: "); String loai = sc.nextLine(); loai = loai.trim().replaceAll("\\s+", " ");
                              ArrayList<Tour> timloai = dstour.timkiemloaitour(loai); 
                              if (!timloai.isEmpty()) 
                                    timloai.forEach(System.out::println);
                              else 
                                    System.out.println("Khong tim thay tour " + loai + " nao.");
                              break;
                        default:
                              System.out.println();
                              System.out.println("*".repeat(WIDTH/3) +" Lua chon khong hop le. Vui long thu lai." + "*".repeat(WIDTH/3));
                  }
            }
            while(choice != 0);
      }
