package QuanLyTour;

import java.time.LocalDate;
public class DatTour {
    private String madattour;
    private KhachHang kh;
    private Tour tour;
    private LocalDate ngaydat;
    private NhanVien nv;
    private String trangthai;

    public DatTour(String madattour, KhachHang kh, Tour tour, LocalDate ngaydat, NhanVien nv, String trangthai) {
        this.madattour = madattour;
        this.kh = kh;
        this.tour = tour;
        this.ngaydat = ngaydat;
        this.nv = nv;
        this.trangthai = trangthai;
    }
    
    public DatTour(KhachHang kh, Tour tour, LocalDate ngaydat, NhanVien nv) {
        this.madattour = "DT" + kh.getmakh() + tour.getmatour();
        this.kh = kh;
        this.tour = tour;
        this.ngaydat = ngaydat;
        this.trangthai = "CHUA_XU_LY";
        this.nv = nv;
    }

    public String getmadattour() { 
        return madattour; 
    }
    public KhachHang getKhachHang() { 
        return kh; 
    }
    public void setKhachHang(KhachHang kh) { 
        this.kh = kh; 
    }
    public NhanVien getNhanVien() { 
        return nv; 
    }
    public void setNhanVien(NhanVien nv) { 
        this.nv = nv; 
    }
    public Tour getTour() { 
        return tour; 
    }
    public void setTour(Tour tour) { 
        this.tour = tour; 
    }
    public LocalDate getngaydat() { 
        return ngaydat; 
    }
    public void setngaydat(LocalDate ngaydat) { 
        this.ngaydat = ngaydat; 
    }
    public String gettrangthai() {
        return trangthai;
    }
    public void settrangthai(String trangthai) {
        this.trangthai = trangthai;
    }

    public String toString() {
        return madattour + " | " + kh.getmakh() + " - " + kh.gethoten()
                + " | " + tour.getmatour() + " - " + tour.gettentour()
                + " | Ngay dat: " + ngaydat + " | " 
                + nv.getmanv() + " - " + trangthai;
    }

    public void xuat() {
        System.out.println(this.toString());
    }
}
