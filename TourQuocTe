package QuanLyTour;

public class TourQuocTe extends Tour {
    private String matourqt;
    private String chauluc;
    private String quocgia;
    private static int count = 1;

    public TourQuocTe() {
        super();
        matourqt = "";
        chauluc = "";
        quocgia = "";
    }
    public TourQuocTe(String matourqt, String tentour, String noikhoihanh, String ngaykhoihanh, String ngayve, int gia, String chauluc, String quocgia) {
        super(tentour, noikhoihanh, ngaykhoihanh, ngayve, gia);
        this.matourqt = matourqt;
        this.chauluc = chauluc;
        this.quocgia = quocgia;
        count++;
    }

    public String toString() {
        return matourqt + ", " + super.toString() + ", Chau luc: " + chauluc + ", Quoc gia: " + quocgia;
    }

    // getter
    public String getmatour() {
        return matourqt;
    }
    public String getchauluc() {
        return chauluc;
    }
    public String getquocgia() {
        return quocgia;
    }

    // setter
    public void setmatourqt(String matourqt) {
        this.matourqt = matourqt;
    }
    public void setchauluc(String chauluc) {
        this.chauluc = chauluc;
    }
    public void setquocgia(String quocgia) {
        this.quocgia = quocgia;
    }

    public void nhap() {
        System.out.println("Nhap thong tin tour quoc te:");
        super.nhap();
        System.out.print("Nhap chau luc: "); setchauluc(Input.sc.nextLine());
        System.out.print("Nhap quoc gia: "); setquocgia(Input.sc.nextLine());
        setmatourqt("TQT" + count);
    }
    public void xuat() {
        System.out.println("Thong tin tour quoc te:");
        System.out.println(this.toString());
    }
}
