package QuanLyTour;

import static QuanLyTour.Input.sc;

public abstract class ConNguoi {
    private String hoten;
    private int tuoi;
    private String gioitinh;
    private int sdt;

    public ConNguoi() {
        hoten = "";
        tuoi = 0;
        gioitinh = "";
        sdt = 0;
    }
    public ConNguoi(String hoten, int tuoi, String gioitinh, int sdt) {
        this.hoten = hoten;
        this.tuoi = tuoi;
        this.gioitinh = gioitinh;
        this.sdt = sdt;
    }

    public String toString() {
        return hoten + ", "+ gioitinh + ", " + tuoi + ", " + sdt;
    }

    // getter
    public String gethoten() {
        return hoten;
    }
    public int gettuoi() {
        return tuoi;
    }
    public String getgioitinh() {
        return gioitinh;
    }
    public int getsdt() {
        return sdt;
    }

    // setter
    public void sethoten(String hoten) {
        while(hoten.trim().equals("")){
            System.out.println("Ho ten khong duoc de trong, vui long nhap lai!");
            System.out.print("Nhap ho ten: ");
            hoten = sc.nextLine();
        }
        this.hoten = hoten;
    }

    public void settuoi(int tuoi) {
        while(tuoi < 0){
            System.out.println("Tuoi khong the la so am, vui long nhap lai!");
            System.out.print("Nhap tuoi: ");
            tuoi = sc.nextInt();
            sc.nextLine();
        }
        this.tuoi = tuoi;
    }
    public void setgioitinh(String gioitinh) {
        while(!gioitinh.equalsIgnoreCase("nam") && !gioitinh.equalsIgnoreCase("nu")){
            System.out.println("Gioi tinh nhap vao phai la nam hoac nu, vui long nhap lai!");
            System.out.print("Nhap gioi tinh: ");
            gioitinh = sc.nextLine();
        }
        this.gioitinh = gioitinh;
    }   
    public void setsdt(int sdt) {
        while(lengthOfPhoneNumber(sdt) != 9){
            System.out.println("So dien thoai phai co 9 so (khong bao gom so 0 dau tien), vui long nhap lai!");
            System.out.print("Nhap so dien thoai: ");
            sdt = sc.nextInt();
            sc.nextLine();
        }
        this.sdt = sdt;
    }

    public int lengthOfPhoneNumber(int sdt){
        int cntLengthOfPhoneNumber = 0;
        while(sdt > 0){
            cntLengthOfPhoneNumber++;
            sdt /= 10;
        }
        return cntLengthOfPhoneNumber;
    }

    public void nhap() {
        System.out.print("Nhap ho ten: "); sethoten(sc.nextLine());
        System.out.print("Nhap gioi tinh: "); setgioitinh(sc.nextLine());
        System.out.print("Nhap tuoi: "); settuoi(Integer.parseInt(sc.nextLine()));
        System.out.print("Nhap so dien thoai: "); setsdt(Integer.parseInt(sc.nextLine()));
    }

    public void xuat() {
        System.out.println("Ho ten: " + gethoten());
        System.out.println("Gioi tinh: " + getgioitinh());
        System.out.println("Tuoi: " + gettuoi());
        System.out.println("So dien thoai: " + getsdt());
    }
 
}
