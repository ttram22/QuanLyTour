package QuanLyTour;

public abstract class Tour {
    private String matour;
    private String tentour;
    private String noikhoihanh;
    private String ngaykhoihanh;
    private String ngayve;
    private double gia;

    public Tour() {
        matour = "";
        tentour = "";
        noikhoihanh = "";
        ngaykhoihanh = "";
        gia = 0;
    }
    public Tour(String matour, String tentour, String noikhoihanh, String ngaykhoihanh, String ngayve, double gia) {
        this.matour = matour;
        this.tentour = tentour;
        this.noikhoihanh = noikhoihanh;
        this.ngaykhoihanh = ngaykhoihanh;
        this.ngayve = ngayve;
        this.gia = gia;
    }

    public String toString() {
        return matour + ", " + tentour + ", " + noikhoihanh + ", " + ngaykhoihanh + ", " + ngayve + ", " + gia;
    }
    
    // getter
    public String getmatour() {
        return matour;
    }
    public String gettentour() {
        return tentour;
    }
    public String getnoikhoihanh() {
        return noikhoihanh;
    }  
    public String getngaykhoihanh() {
        return ngaykhoihanh;
    }
    public String getngayve() {
        return ngayve;
    }
    public double getgia() {
        return gia;
    }

    // setter
    public void setmatour(String matour) {
        this.matour = matour;
    }
    public String settentour(String tentour) {
        this.tentour = tentour;
        return tentour;
    }
    public void setnoikhoihanh(String noikhoihanh) {
        this.noikhoihanh = noikhoihanh;
    }
    public void setngaykhoihanh(String ngaykhoihanh) {
        this.ngaykhoihanh = ngaykhoihanh;
    }
    public void setngayve(String ngayve) {
        this.ngayve = ngayve;
    }
    public double setgia(double gia) {
        this.gia = gia;
        return gia;
    }

    public void nhap() {
        System.out.print("Nhap ma tour: "); setmatour(Input.sc.nextLine());
        System.out.print("Nhap ten tour: "); settentour(Input.sc.nextLine());
        System.out.print("Nhap noi khoi hanh: "); setnoikhoihanh(Input.sc.nextLine());
        System.out.print("Nhap ngay khoi hanh: "); setngaykhoihanh(Input.sc.nextLine());
        System.out.print("Nhap gia: "); setgia(Double.parseDouble(Input.sc.nextLine()));
    }

    public void xuat() {
        System.out.println(this.toString());
    }
}
