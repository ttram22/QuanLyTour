package QuanLyTour;

import java.util.ArrayList;
import java.io.FileWriter;
import java.io.BufferedReader;
import java.io.FileReader;

import static QuanLyTour.Input.sc;
public class DanhSachNhanVien implements QuanLy<NhanVien> {
    ArrayList<NhanVien> dsnv = new ArrayList<>();
    
    public void xuatdanhsach() {
        System.out.println("==== DANH SACH SACH NHAN VIEN ====");
        for (NhanVien nv : dsnv) {
            System.out.println(nv);
        }
    }
    public void them(NhanVien nv) {
        dsnv.add(nv);
        ghifile();
        System.out.println("Them nhan vien thanh cong!");
    }
    public void xoa(String manv) {
        for (NhanVien nv : dsnv) {
            if (nv.getmanv().equals(manv)) {
                dsnv.remove(nv);
                ghifile();
                System.out.println("Xoa nhan vien thanh cong!");
                break;
            }
            else {
                System.out.println("nvong tim thay nvach hang co ma: " + manv);
            }
        }          
    }
    public void sua(String manv) {
        for (NhanVien nv : dsnv) {
            if (nv.getmanv().equals(manv)) {
                System.out.println("Chon thong tin muon sua:");
                System.out.println("1. Ho ten");
                System.out.println("2. Gioi tinh");
                System.out.println("3. Tuoi");
                System.out.println("4. So dien thoai");
                System.out.print("Nhap lua chon: "); int choice = sc.nextInt();
                sc.nextLine(); // Bo qua dong enter

                switch (choice) {
                    case 1:
                        System.out.print("Nhap ho ten moi: ");
                        String hoten = sc.nextLine();
                        nv.sethoten(hoten);
                        ghifile();
                        break;
                    case 2:
                        System.out.print("Nhap gioi tinh moi: ");
                        String gioitinh = sc.nextLine();
                        nv.setgioitinh(gioitinh);
                        ghifile();
                        break;
                    case 3:
                        System.out.print("Nhap tuoi moi: ");
                        int tuoi = sc.nextInt();
                        nv.settuoi(tuoi);
                        ghifile();
                        break;
                    case 4:
                        System.out.print("Nhap so dien thoai moi: ");
                        int sdt = sc.nextInt();
                        nv.setsdt(sdt);
                        ghifile();
                        break;
                    default:
                        System.out.println("Lua chon chon khong hop le.");
                        return;
                }
            }
        }
        System.out.println("Khong tim thay nhan vien co ma: " + manv);
    }
    public NhanVien timkiem(String manv) {
        for (NhanVien nv : dsnv) {
            if (nv.getmanv().equals(manv)) {
                return nv;
            }
        }
        return null;
    }
    
    //  TÌM KIẾM NÂNG CAO
    public NhanVien timkiemten(String ten) {
        for (NhanVien nv : dsnv) {
            if (nv.gethoten().equalsIgnoreCase(ten)) 
                return nv;
        }
        return null;
    }
    public NhanVien timkiemsdt(int sdt) {
        for (NhanVien nv : dsnv) {
            if (nv.getsdt() == (sdt)) 
                return nv;
        }
        return null;
    }

    public void docfile() {
        try { 
            BufferedReader read = new BufferedReader(new FileReader("D:\\JAVA\\OOP\\QuanLyTour\\DanhSachNhanVien.txt"));
            String line;

            while ((line = read.readLine()) != null) {
                String[] parts = line.split(",");
                // Loại bỏ nvoảng trắng dư
                for (int i=0; i<parts.length; i++) {
                    parts[i] = parts[i].trim();
                }

                if (parts.length == 5) {
                    String manv = parts[0];
                    String hoten = parts[1];
                    String gioitinh = parts[2];
                    int tuoi = Integer.parseInt(parts[3]);
                    int sdt = Integer.parseInt(parts[4]);

                    NhanVien nv = new NhanVien(manv, hoten, gioitinh, tuoi, sdt);
                    dsnv.add(nv);
                }
            }
            read.close();
        } 
        catch (Exception e) {
            System.out.println("Loi khi doc file: " + e);
        }
    }
    public void ghifile() {
        try {
            FileWriter fw = new FileWriter("D:\\JAVA\\OOP\\QuanLyTour\\DanhSachNhanVien.txt");
            for (NhanVien nv : dsnv) {
                fw.write(nv.getmanv() + "," + nv.gethoten() + "," + nv.getgioitinh() + "," + nv.gettuoi() + "," + nv.getsdt() + "\n");
            }
            fw.close();
        } 
        catch (Exception e) {
            System.out.println("Loi khi ghi file: " + e);
        }
    }
}
